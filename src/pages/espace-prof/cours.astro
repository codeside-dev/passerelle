---
import Espace from "../../layouts/Espace.astro";
import Carte from "../../components/Carte.astro";

const annonces = [
  { titre: "Fonctions et dérivées", matiere: "Mathématiques", niveaux: "Seconde · Première · Terminale", tarif: "32 € / h", etat: "Publiée" },
  { titre: "Suites et probabilités", matiere: "Mathématiques", niveaux: "Première · Terminale", tarif: "34 € / h", etat: "Publiée" },
  { titre: "Préparation au bac — spécialité", matiere: "Mathématiques", niveaux: "Terminale", tarif: "38 € / h", etat: "Publiée" },
  { titre: "Remise à niveau — seconde", matiere: "Mathématiques", niveaux: "Seconde", tarif: "30 € / h", etat: "Brouillon" },
];
---

<Espace
  espace="prof"
  actif="cours"
  titre="Mes cours"
  sousTitre="Annonces et tarifs"
  titrePage="Mes cours"
>
  <div class="flex flex-col gap-1">
    <h1 class="text-[24px] font-bold tracking-[-0.5px]">Mes cours</h1>
    <p class="text-sm text-[var(--color-muted)]">Trois annonces publiées, un brouillon.</p>
  </div>

  <Carte titre="Annonces">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[680px] border-collapse text-left">
        <thead>
          <tr class="border-b border-[var(--color-line)]">
            {
              ["Cours", "Niveaux", "Tarif", "État"].map((t) => (
                <th class="pb-2.5 font-mono text-[11px] font-semibold tracking-[1px] text-[var(--color-muted)]">
                  {t.toUpperCase()}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            annonces.map((a) => (
              <tr class="border-b border-[var(--color-line)] last:border-0">
                <td class="py-3.5">
                  <span class="flex flex-col">
                    <span class="text-[15px] font-semibold">{a.titre}</span>
                    <span class="text-[13px] text-[var(--color-muted)]">{a.matiere}</span>
                  </span>
                </td>
                <td class="py-3.5 text-sm text-[var(--color-muted)]">{a.niveaux}</td>
                <td class="py-3.5 font-mono text-sm font-semibold">{a.tarif}</td>
                <td class="py-3.5">
                  <span
                    class={
                      a.etat === "Publiée"
                        ? "rounded-full bg-[var(--color-accent-pale)] px-3 py-1 text-xs font-semibold text-[var(--color-accent)]"
                        : "rounded-full bg-[var(--color-alt)] px-3 py-1 text-xs font-semibold text-[var(--color-muted)]"
                    }
                  >
                    {a.etat}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Carte>
</Espace>
