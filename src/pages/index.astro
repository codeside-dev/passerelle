---
import Vitrine from "../layouts/Vitrine.astro";
import CarteProfesseur from "../components/CarteProfesseur.astro";
import { cours } from "../data/cours";
import heros from "../assets/heros.jpg";

const matieres = [
  { pastille: "∑", nom: "Mathématiques", compte: "318 professeurs" },
  { pastille: "Φ", nom: "Physique-Chimie", compte: "204 professeurs" },
  { pastille: "¶", nom: "Français", compte: "256 professeurs" },
  { pastille: "En", nom: "Anglais", compte: "231 professeurs" },
  { pastille: "SVT", nom: "SVT", compte: "147 professeurs" },
  { pastille: "HG", nom: "Histoire-Géo", compte: "168 professeurs" },
  { pastille: "Ph", nom: "Philosophie", compte: "96 professeurs" },
  { pastille: "Es", nom: "Espagnol", compte: "112 professeurs" },
];

const preuves = [
  { chiffre: "1 200+", legende: "professeurs vérifiés" },
  { chiffre: "38 000", legende: "cours donnés depuis 2021" },
  { chiffre: "4,9 / 5", legende: "note moyenne sur 6 400 avis" },
  { chiffre: "92 %", legende: "des élèves gagnent 2 points" },
];

const etapes = [
  {
    titre: "Décrivez le besoin",
    texte:
      "Matière, niveau, difficulté, objectif. Deux minutes suffisent pour cerner ce qui bloque.",
  },
  {
    titre: "Choisissez un professeur",
    texte:
      "Chaque profil affiche ses niveaux, son tarif et les avis d'élèves qu'il a suivis.",
  },
  {
    titre: "Réservez le créneau",
    texte:
      "Le cours a lieu en visioconférence, dans l'outil que vous voulez. Aucun logiciel à installer.",
  },
];

const arguments_ = [
  {
    titre: "Des professeurs vérifiés",
    texte:
      "Diplôme contrôlé, entretien pédagogique, et les trois premiers cours sont suivis par notre équipe.",
  },
  {
    titre: "Un vrai suivi",
    texte:
      "Après chaque cours, un compte rendu écrit : ce qui a été travaillé, ce qui reste à consolider.",
  },
  {
    titre: "Sans engagement",
    texte:
      "Vous payez le cours, pas un abonnement. Annulation gratuite jusqu'à vingt-quatre heures avant.",
  },
];

const temoignages = [
  {
    citation:
      "« Ma fille est passée de 8 à 14 en maths en un trimestre. Le professeur a compris en un cours ce qui bloquait depuis la 4e. »",
    auteur: "Hélène M.",
    role: "mère d'une élève de Seconde",
  },
  {
    citation:
      "« Je n'osais pas lever la main en classe. Maintenant je comprends ce que je fais, et ça se voit sur les notes. »",
    auteur: "Adam T.",
    role: "élève de Première, Lyon",
  },
];

const misEnAvant = cours.slice(0, 3);
---

<Vitrine
  title="Passerelle — Soutien scolaire du collège au lycée"
  description="Des professeurs vérifiés, toutes les matières, du collège au lycée. Vous choisissez le créneau, le cours a lieu en visioconférence."
>
  <section class="mx-auto grid w-full max-w-[1440px] items-center gap-14 px-6 pt-[76px] pb-[72px] lg:grid-cols-2 lg:px-[72px]">
    <div class="flex max-w-[620px] flex-col gap-[22px]">
      <p class="font-mono text-xs font-semibold tracking-[1.2px] text-[var(--color-muted)]">
        SOUTIEN SCOLAIRE · COLLÈGE ET LYCÉE
      </p>
      <h1 class="font-display text-[40px] font-bold leading-[1.08] tracking-[-1.6px] sm:text-[52px]">
        Comprendre enfin, au lieu d'apprendre par cœur.
      </h1>
      <p class="max-w-[560px] text-[17px] leading-[1.55] text-[var(--color-muted)]">
        Des professeurs vérifiés, toutes les matières, du collège au lycée. Vous choisissez le créneau, le cours a lieu en visioconférence.
      </p>
      <div class="flex flex-wrap items-center gap-3.5">
        <a href="/cours" class="rounded-[10px] bg-[var(--color-accent)] px-7 py-[15px] text-[15px] font-semibold text-white transition hover:brightness-110">
          Trouver un professeur
        </a>
        <a href="/cours" class="rounded-[10px] border border-[var(--color-line)] px-7 py-[15px] text-[15px] font-semibold transition hover:bg-[var(--color-alt)]">
          Voir les tarifs
        </a>
      </div>
      <p class="text-[13px] text-[var(--color-muted)]">
        Premier cours satisfait ou remboursé · Sans abonnement
      </p>
    </div>

    <img
      src={heros.src}
      alt="Deux élèves travaillant ensemble sur une table"
      width={heros.width}
      height={heros.height}
      class="h-[300px] w-full rounded-[22px] object-cover sm:h-[440px]"
    />
  </section>

  <section class="border-y border-[var(--color-line)] bg-[var(--color-alt)]">
    <div class="mx-auto grid w-full max-w-[1440px] gap-8 px-6 py-[38px] sm:grid-cols-2 lg:grid-cols-4 lg:px-[72px]">
      {preuves.map((preuve) => (
        <div class="flex flex-col gap-1">
          <span class="text-[32px] font-bold tracking-[-1px]">{preuve.chiffre}</span>
          <span class="text-sm text-[var(--color-muted)]">{preuve.legende}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto flex w-full max-w-[1440px] flex-col gap-10 px-6 py-[88px] lg:px-[72px]">
    <div class="flex max-w-[720px] flex-col gap-3">
      <p class="font-mono text-xs font-semibold tracking-[1.2px] text-[var(--color-muted)]">MATIÈRES</p>
      <h2 class="font-display text-[32px] font-bold leading-[1.15] tracking-[-1.2px] sm:text-[40px]">
        Toutes les matières, du collège au lycée.
      </h2>
      <p class="max-w-[660px] text-base leading-[1.55] text-[var(--color-muted)]">
        Huit matières principales, et une trentaine d'autres sur demande. Les professeurs enseignent de la 6e à la Terminale.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {matieres.map((matiere) => (
        <div class="flex h-[132px] flex-col gap-3 rounded-2xl border border-[var(--color-line)] bg-[var(--color-alt)] p-[22px]">
          <span class="grid size-[38px] place-items-center rounded-[11px] bg-[var(--color-accent-pale)] font-mono text-[15px] font-semibold text-[var(--color-accent)]">
            {matiere.pastille}
          </span>
          <span class="text-base font-semibold">{matiere.nom}</span>
          <span class="text-[13px] text-[var(--color-muted)]">{matiere.compte}</span>
        </div>
      ))}
    </div>
  </section>

  <section id="comment" class="bg-[var(--color-alt)]">
    <div class="mx-auto flex w-full max-w-[1440px] flex-col gap-11 px-6 py-[88px] lg:px-[72px]">
      <div class="flex max-w-[720px] flex-col gap-3">
        <p class="font-mono text-xs font-semibold tracking-[1.2px] text-[var(--color-muted)]">COMMENT ÇA MARCHE</p>
        <h2 class="font-display text-[32px] font-bold leading-[1.15] tracking-[-1.2px] sm:text-[40px]">
          Trois étapes, et le cours est réservé.
        </h2>
      </div>

      <div class="grid gap-7 md:grid-cols-3">
        {etapes.map((etape, i) => (
          <div class="flex flex-col gap-3.5">
            <span class="grid size-9 place-items-center rounded-[18px] bg-[var(--color-accent)] font-mono text-[15px] font-semibold text-white">
              {i + 1}
            </span>
            <h3 class="text-xl font-bold tracking-[-0.4px]">{etape.titre}</h3>
            <p class="max-w-[380px] text-[15px] leading-relaxed text-[var(--color-muted)]">{etape.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto flex w-full max-w-[1440px] flex-col gap-11 px-6 py-[88px] lg:px-[72px]">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div class="flex max-w-[660px] flex-col gap-3">
        <p class="font-mono text-xs font-semibold tracking-[1.2px] text-[var(--color-muted)]">PROFESSEURS</p>
        <h2 class="font-display text-[32px] font-bold leading-[1.15] tracking-[-1.2px] sm:text-[40px]">
          Des professeurs vérifiés, pas des annonces.
        </h2>
      </div>
      <a href="/cours" class="text-[15px] font-semibold text-[var(--color-accent)] transition hover:underline">
        Voir tous les professeurs →
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {misEnAvant.map((c) => <CarteProfesseur cours={c} />)}
    </div>
  </section>

  <section class="bg-[var(--color-ink)]">
    <div class="mx-auto flex w-full max-w-[1440px] flex-col gap-12 px-6 py-[88px] lg:px-[72px]">
      <div class="flex max-w-[760px] flex-col gap-3.5">
        <p class="font-mono text-xs font-semibold tracking-[1.2px] text-[var(--color-accent-pale)]">LA CONFIANCE</p>
        <h2 class="font-display text-[32px] font-bold leading-[1.15] tracking-[-1.2px] text-[var(--color-night-text)] sm:text-[40px]">
          Un professeur vérifié, un suivi écrit, aucun engagement.
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {arguments_.map((argument) => (
          <div class="flex flex-col gap-3">
            <h3 class="text-xl font-bold tracking-[-0.4px] text-[var(--color-night-text)]">{argument.titre}</h3>
            <p class="max-w-[390px] text-[15px] leading-[1.65] text-[var(--color-night-text)]">{argument.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto flex w-full max-w-[1440px] flex-col gap-10 px-6 py-[88px] lg:px-[72px]">
    <div class="flex max-w-[720px] flex-col gap-3">
      <p class="font-mono text-xs font-semibold tracking-[1.2px] text-[var(--color-muted)]">TÉMOIGNAGES</p>
      <h2 class="font-display text-[32px] font-bold leading-[1.15] tracking-[-1.2px] sm:text-[40px]">
        Ce que ça change, concrètement.
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {temoignages.map((t) => (
        <blockquote class="flex h-full flex-col gap-5 rounded-[18px] border border-[var(--color-line)] bg-[var(--color-alt)] p-8">
          <p class="max-w-[570px] text-[19px] font-medium leading-normal">{t.citation}</p>
          <footer class="mt-auto flex flex-col gap-1">
            <cite class="text-[15px] font-bold not-italic">{t.auteur}</cite>
            <span class="text-sm text-[var(--color-muted)]">{t.role}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </section>

  <section class="bg-[var(--color-alt)]">
    <div class="mx-auto flex w-full max-w-[1440px] flex-col items-center gap-5 px-6 py-[84px] text-center lg:px-[72px]">
      <p class="font-mono text-xs font-semibold tracking-[1.2px] text-[var(--color-muted)]">
        PREMIER COURS SATISFAIT OU REMBOURSÉ
      </p>
      <h2 class="max-w-[820px] font-display text-[34px] font-bold leading-[1.12] tracking-[-1.4px] sm:text-[44px]">
        Trouvez le professeur qu'il vous faut.
      </h2>
      <p class="max-w-[620px] text-[17px] leading-[1.55] text-[var(--color-muted)]">
        Décrivez le besoin, comparez les profils, réservez le créneau. Le premier cours est remboursé s'il ne convient pas.
      </p>
      <a href="/cours" class="rounded-xl bg-[var(--color-accent)] px-[30px] py-4 text-base font-semibold text-white transition hover:brightness-110">
        Trouver un professeur
      </a>
      <p class="font-mono text-[13px] text-[var(--color-muted)]">
        1 200 professeurs · 38 000 cours · 4,9 / 5
      </p>
    </div>
  </section>
</Vitrine>
