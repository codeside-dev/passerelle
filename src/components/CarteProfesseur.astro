---
import type { Cours } from "../data/cours";

interface Props {
  cours: Cours;
  /** Hauteur du bandeau : 280 sur l'accueil, 200 sur la liste. */
  hauteurBandeau?: string;
}

const { cours, hauteurBandeau = "h-[280px]" } = Astro.props;

/* Initiales plutot qu'un portrait : la recherche d'images libres n'a pas
   donne de visages credibles pour des enseignants, et presenter des enfants
   ou des inconnus comme professeurs serait pire que pas de photo du tout. */
const initiales = cours.professeur
  .split(" ")
  .map((mot) => mot[0])
  .join("")
  .slice(0, 2);
---

<article class="relative flex h-full flex-col overflow-hidden rounded-[18px] border border-[var(--color-line)] bg-[var(--color-fond)]">
  <div class={`flex items-center justify-center bg-[var(--color-alt)] ${hauteurBandeau}`}>
    <span class="font-display text-[56px] font-bold tracking-[-2px] text-[var(--color-accent)]">
      {initiales}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-2 p-[22px] pb-[24px]">
    <h3 class="text-[18px] font-bold tracking-[-0.4px]">
      <a
        href={`/cours/${cours.slug}`}
        class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      >
        {cours.professeur}
      </a>
    </h3>
    <p class="text-[13px] font-semibold text-[var(--color-accent)]">{cours.matiere}</p>
    <p class="text-[13px] text-[var(--color-muted)]">{cours.niveau}</p>
    <div class="mt-auto flex items-center justify-between gap-3 pt-2">
      <span class="font-mono text-xs text-[var(--color-muted)]">
        {cours.note} ★ · {cours.avis} avis
      </span>
      <span class="text-[17px] font-bold">{cours.tarif} € / heure</span>
    </div>
  </div>
</article>
